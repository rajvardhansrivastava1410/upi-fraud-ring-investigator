# ==============================================================================
# AegisUPI - API Keys & Environment Configuration (Template)
# Rename this file to .env and insert your API keys
# ==============================================================================

# 1. Google Gemini API Key (For AI investigator narrative summaries)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Kaggle API Credentials (For pulling PaySim, IBM AML, IEEE-CIS)
# Get from: https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_KEY="your_kaggle_api_key_here"

# 3. Server Port Configuration
PORT=8000
HOST="0.0.0.0"

# 4. CARTO Maps & Location Intelligence API
# Get your API key / Access Token at: https://app.carto.com -> Developer Settings -> API Keys
# Supports CARTO 3 / CARTO Developer Access Tokens & Vector Tiles
CARTO_API_KEY="your_carto_api_key_here"
CARTO_BASEMAP_STYLE="dark-matter"
