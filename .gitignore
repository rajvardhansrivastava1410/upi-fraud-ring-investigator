# ==============================================================================
# AegisUPI - .gitignore for GitHub Repository
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Large Datasets (>100MB blocked by GitHub)
# ------------------------------------------------------------------------------
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Ignore raw data folders
data/*.csv
backend/data/*.csv

# Keep JSON models, ground truth, and small Gemini instruction datasets
!data/*.json
!data/*.jsonl
!data/dataset.json
!data/ground_truth.json
!data/*_model_results.json
!data/trained_model.json
!data/ieee_test_evaluation.json
!data/gemini_*.jsonl

